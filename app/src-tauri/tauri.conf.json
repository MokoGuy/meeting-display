{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Display",
  "version": "0.5.0",
  "identifier": "com.mokoguy.meeting-display",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Meeting Display",
        "width": 340,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "meeting-display",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQTQxNzE2NEMzM0VENwpSV1RYUHNOa2NVRzZCZExyTnZZVGFwQTFGbkJVRythaVl6L0Y0WkZyTkpmN1J4NHRHVXZLYnlySAo=",
      "endpoints": [
        "https://github.com/MokoGuy/meeting-display/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
